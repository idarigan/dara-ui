{
  "name": "dara-ui",
  "version": "0.3.0",
  "description": "Some Modernlike React component library with full RTL and theming support.",
  "type": "module",
  "license": "MIT",
  "author": "Dara <thedarigan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idarigan/dara-ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/dara-ui.cjs.js",
  "module": "./dist/dara-ui.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dara-ui.es.js",
      "require": "./dist/dara-ui.cjs.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "glassmorphism",
    "cyberpunk",
    "rtl",
    "i18n",
    "theming",
    "design-system"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i src/styles/index.css -o build/style.css --minify",
    "build": "npm run build:css && tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "storybook build && vercel --prod",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/theming": "^8.6.18",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.2",
    "@tailwindcss/cli": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vercel": "^37.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.9"
  }
}
